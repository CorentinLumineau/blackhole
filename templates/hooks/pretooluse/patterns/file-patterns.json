{
  "version": 1,
  "_note": "Sensitive-filename patterns read by the pre-git-add staging gate (implementer.md, gates/07) and the reviewer V-SEC-11 audit. Data, not code. A match excludes the path from staging and is reported; nothing denies a tool call (ADR-065). The only consumer is the staging gate: add a pattern here, never a second list (V-INT-02).",
  "sensitiveFiles": [
    {
      "id": "env",
      "pattern": "(^|/)\\.env$",
      "flags": "i",
      "reason": "Environment file — may hold credentials"
    },
    {
      "id": "env-suffixed",
      "pattern": "(^|/)\\.env\\.[^/]+$",
      "flags": "i",
      "reason": "Environment file variant — may hold credentials"
    },
    {
      "id": "credentials-json",
      "pattern": "(^|/)credentials\\.json$",
      "flags": "i",
      "reason": "Credential store"
    },
    {
      "id": "secrets-json",
      "pattern": "(^|/)secrets\\.json$",
      "flags": "i",
      "reason": "Secret store"
    },
    {
      "id": "pem",
      "pattern": "\\.pem$",
      "flags": "i",
      "reason": "PEM-encoded key or certificate"
    },
    {
      "id": "private-key",
      "pattern": "\\.key$",
      "flags": "i",
      "reason": "Private key material"
    },
    {
      "id": "certificate",
      "pattern": "\\.crt$",
      "flags": "i",
      "reason": "Certificate material"
    },
    {
      "id": "id-rsa",
      "pattern": "(^|/)id_rsa",
      "flags": "i",
      "reason": "SSH private key"
    },
    {
      "id": "id-ed25519",
      "pattern": "(^|/)id_ed25519",
      "flags": "i",
      "reason": "SSH private key"
    },
    {
      "id": "ssh-dir",
      "pattern": "(^|/)\\.ssh/",
      "flags": "i",
      "reason": "SSH configuration and key directory"
    },
    {
      "id": "aws-credentials",
      "pattern": "(^|/)\\.aws/credentials$",
      "flags": "i",
      "reason": "AWS credential file"
    },
    {
      "id": "netrc",
      "pattern": "(^|/)\\.netrc$",
      "flags": "i",
      "reason": "Machine credential file"
    },
    {
      "id": "npmrc",
      "pattern": "(^|/)\\.npmrc$",
      "flags": "i",
      "reason": "npm registry token file"
    },
    {
      "id": "pypirc",
      "pattern": "(^|/)\\.pypirc$",
      "flags": "i",
      "reason": "PyPI registry token file"
    }
  ]
}
